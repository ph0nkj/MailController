# HTTP
MC_ADDR=:8080
MC_BASE_URL=http://localhost:8080
MC_DB_PATH=/data/mc.db
MC_LOG_LEVEL=info

# Security (required)
# Generate with: openssl rand -base64 32
MC_SECRET_KEY=
MC_ADMIN_PASSWORD=
# Enable when the service is served over HTTPS.
MC_COOKIE_SECURE=false

# Google OAuth client (optional; can also be saved in Settings)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Campaign sending
MC_SEND_RATE_PER_MIN=60
MC_DAILY_SEND_LIMIT=500
MC_UNSUBSCRIBE_ENABLED=true
MC_UNSUBSCRIBE_EMAIL=

# AI assistant
MC_LLM_MAX_MESSAGES=200
MC_LLM_BODY_CHARS=2000

# Mailbox agent
MC_AGENT_MAX_MESSAGES=10000
MC_AGENT_MAX_STEPS=5
